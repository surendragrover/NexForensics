{
  "hypothesis_type": "financial_fraud_bank_instrument",
  "name": "Bank Guarantee / LoU Fraud",
  "priority": 2,
  "triggers": [
    "letter of undertaking",
    "letters of undertaking",
    "lou",
    "swift",
    "core banking",
    "buyer's credit",
    "bank guarantee"
  ],
  "investigation_directions": [
    {
